{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/search-book",
      "destination": "/api/search-book"
    },
    {
      "source": "/api/book-search",
      "destination": "/api/book-search"
    },
    {
      "source": "/api/cover-lookup",
      "destination": "/api/cover-lookup"
    },
    {
      "source": "/api/isbn/:isbn",
      "destination": "/api/isbn?isbn=:isbn"
    },
    {
      "source": "/api/isbn",
      "destination": "/api/isbn"
    },
    {
      "source": "/api/gemini/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/download-card-png",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
